# Copy to .env next to docker-compose.yml. Only publishable/public values here —
# never the Supabase service-role key.

# Supabase API as the *viewer's browser or phone* reaches it. Local browser on this
# machine: http://127.0.0.1:54321. Other devices on the LAN: http://<this-mac-LAN-IP>:54321
NER_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Publisher -> Supabase Postgres (server-side only). Local Supabase CLI stack:
SIH_PUBLISH_DSN=postgresql://postgres:postgres@host.docker.internal:54322/postgres
